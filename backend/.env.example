# MongoDB connection string — get this from MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster.xxxxx.mongodb.net/team-task-manager

# JWT secret — use a long random string (run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here

# Server port
PORT=5000

# Client URL (for CORS) — update this after deploying the client
CLIENT_URL=http://localhost:5173
